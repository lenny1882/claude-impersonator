#!/usr/bin/env python3
"""builds-sync: the command. All the work is in lib/builds_sync.py, the same
module the pipeline and the runtimes load, so the command and the library
never disagree. Installed as a copy in ~/.local/bin, so it finds the module in
the installed skill directory first and only falls back to the checkout it
sits in (for a run straight from the source tree)."""
import importlib.util
import os
import sys

sys.dont_write_bytecode = True   # never leave __pycache__ in the skill directory or a checkout


def _module_path():
    claude = os.environ.get("CLAUDE_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(claude, "skills", "builds-sync", "lib", "builds_sync.py"),
              os.path.join(here, "..", "lib", "builds_sync.py")):
        if os.path.isfile(p):
            return p
    sys.stderr.write("builds-sync: lib/builds_sync.py not found; reinstall the package\n")
    sys.exit(1)


spec = importlib.util.spec_from_file_location("builds_sync", _module_path())
bs = importlib.util.module_from_spec(spec)
spec.loader.exec_module(bs)

if __name__ == "__main__":
    sys.exit(bs.main(sys.argv[1:], [sys.executable, os.path.realpath(__file__)]))
