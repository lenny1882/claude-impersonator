#!/usr/bin/env python3
"""A stand-in for `age-keygen`, for the tests only: -o FILE writes a key,
-y FILE prints its recipient (the same derivation the stand-in age uses)."""
import hashlib, os, sys
args = sys.argv[1:]
if args[:1] == ["-y"]:
    for line in open(args[1]):
        if line.startswith("AGE-SECRET-KEY-"):
            print("age1" + hashlib.sha256(line.strip().encode()).hexdigest()[:40])
            sys.exit(0)
    sys.exit("age-keygen: no identity in %s" % args[1])
if args[:1] == ["-o"]:
    secret = "AGE-SECRET-KEY-1" + os.urandom(24).hex().upper()
    rc = "age1" + hashlib.sha256(secret.encode()).hexdigest()[:40]
    fd = os.open(args[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.write(fd, ("# public key: %s\n%s\n" % (rc, secret)).encode())
    os.close(fd)
    sys.exit(0)
sys.exit("usage: age-keygen -o FILE | -y FILE")
